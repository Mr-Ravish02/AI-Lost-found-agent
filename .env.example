# Environment Configuration
# Copy this file to .env and adjust variables as needed

# Database & Security
DATABASE_URL=sqlite:///./smart_lost_found.db
JWT_SECRET=super-secret-key-change-in-production-lost-and-found-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI / LLM Integration (Groq / IBM watsonx / OpenAI compatible)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Uploads directory
UPLOAD_DIR=uploads
